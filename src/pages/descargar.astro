---
/**
 * Descarga en español. Muestra un aviso si la redirección al APK falló.
 */
import DownloadView from '@/components/views/DownloadView.astro';
import { getReleases } from '@/lib/releases';

const payload = await getReleases();
const estado = Astro.url.searchParams.get('estado');
---

<DownloadView locale="es" payload={payload} estado={estado} />
