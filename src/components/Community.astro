---
/**
 * Comunidad: opiniones reales y formulario para dejar la propia.
 *
 * No hay testimonios inventados. Las opiniones se leen de los issues
 * públicos del repositorio (ver `src/lib/reviews.ts`), firmadas por cuentas
 * reales. Si todavía no hay ninguna, la sección lo dice con claridad en lugar
 * de rellenar con reseñas de mentira.
 *
 * El formulario lleva la opinión al compositor de issues de GitHub: la
 * publica la persona con su cuenta, así la atribución es verificable y el
 * moderador puede cerrar el issue para retirarla.
 */
import Icon from '@/components/Icon.astro';
import ReviewForm from '@/components/ReviewForm.astro';
import { communityCopy } from '@/lib/reviews';
import { getReviews } from '@/lib/reviews-server';
import { formatDate } from '@/lib/format';
import { useTranslations } from '@/i18n/ui';
import type { Locale } from '@/config/routes';

interface Props {
  locale: Locale;
  /** Versiones publicadas, para el selector del formulario. */
  versions?: string[];
}

const { locale, versions = [] } = Astro.props;
const copy = communityCopy;
const t = useTranslations(locale);

const payload = await getReviews();
const reviews = payload.reviews;
const average = payload.average;
const hasReviews = reviews.length > 0;

const fullStars = average === null ? 0 : Math.round(average);
---

<section class="section section--soft" id="comunidad">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t('community.eyebrow')}</p>
      <h2>{t('community.title')}</h2>
      <p class="lede">{t('community.desc')}</p>
    </div>

    <div class="community">
      <div class="community__form">
        <div class="community__form-head">
          <span class="card__icon" aria-hidden="true">
            <Icon name="message" size={20} />
          </span>
          <div>
            <h3 class="community__form-title">{copy.formTitle[locale]}</h3>
            <p class="community__form-intro">{copy.formIntro[locale]}</p>
          </div>
        </div>

        <ReviewForm locale={locale} versions={versions} />
      </div>

      <div class="community__reviews">
        {
          hasReviews && average !== null ? (
            <div class="community__summary">
              <div class="community__score">
                <span class="community__score-value">{average.toFixed(1)}</span>
                <span class="community__score-max">/ 5</span>
              </div>
              <div class="community__summary-body">
                <div class="community__stars" aria-hidden="true">
                  {[1, 2, 3, 4, 5].map((star) => (
                    <span class:list={['community__star', { 'is-on': star <= fullStars }]}>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                        <path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8z" />
                      </svg>
                    </span>
                  ))}
                </div>
                <p class="community__summary-text">
                  {copy.summaryAverage[locale].replace('{value}', average.toFixed(1))}
                  {' · '}
                  {copy.summaryCount[locale].replace('{count}', String(reviews.length))}
                </p>
              </div>
            </div>
          ) : (
            <div class="community__empty">
              <span class="card__icon" aria-hidden="true">
                <Icon name="message" size={20} />
              </span>
              <div>
                <p class="community__empty-title">{copy.summaryEmpty[locale]}</p>
              </div>
            </div>
          )
        }

        {
          hasReviews && (
            <ul class="reviews">
              {reviews.map((review) => (
                <li class="review">
                  <div class="review__head">
                    <img
                      class="review__avatar"
                      src={`https://github.com/${review.author}.png?size=72`}
                      width="36"
                      height="36"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="review__who">
                      <a class="review__author" href={review.authorUrl} rel="noopener nofollow" target="_blank">
                        {review.author}
                      </a>
                      <p class="review__meta">
                        <time datetime={review.date}>{formatDate(review.date, locale)}</time>
                        {review.version && ` · ${copy.reviewVersion[locale].replace('{version}', review.version)}`}
                      </p>
                    </div>
                    <div class="review__rating" aria-label={`${review.rating} de 5`}>
                      <span class="community__stars" aria-hidden="true">
                        {[1, 2, 3, 4, 5].map((star) => (
                          <span class:list={['community__star', { 'is-on': star <= review.rating }]}>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                              <path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8z" />
                            </svg>
                          </span>
                        ))}
                      </span>
                    </div>
                  </div>

                  <p class="review__text">{review.text}</p>

                  <p class="review__source">
                    <Icon name="code" size={13} />
                    <a href={review.sourceUrl} rel="noopener nofollow" target="_blank">
                      {copy.reviewSource[locale]}
                    </a>
                    {review.lang !== locale && <span class="review__lang">{review.lang.toUpperCase()}</span>}
                  </p>
                </li>
              ))}
            </ul>
          )
        }

        <p class="community__moderation tiny muted">{copy.sourceNote[locale]}</p>
      </div>
    </div>
  </div>
</section>
