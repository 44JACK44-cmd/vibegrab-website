---
/**
 * Historial de versiones: todas las publicaciones oficiales en una rejilla de
 * carteles, ordenadas por fecha real de publicación (no por número de versión).
 *
 * Cada cartel es compacto y muestra solo lo esencial. El resto de la
 * información (novedades, descargas, huella) aparece al pulsarlo, así el
 * historial no crece de forma lineal cada vez que se publica una versión.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import ReleaseTile from '@/components/ReleaseTile.astro';
import DataStatus from '@/components/DataStatus.astro';
import type { ReleasesPayload } from '@/lib/releases';
import { path, type Locale } from '@/config/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
  payload: ReleasesPayload;
}

const { locale, payload } = Astro.props;
const t = useTranslations(locale);

const stable = payload.releases.filter((release) => !release.prerelease && release.apk);
const prereleases = payload.releases.filter((release) => release.prerelease);
const withoutApk = payload.releases.filter((release) => !release.apk && !release.prerelease);
const hasReleases = stable.length > 0 || prereleases.length > 0 || withoutApk.length > 0;

const totalDownloads = payload.releases.reduce(
  (total, release) => total + (release.apk?.downloadCount ?? 0),
  0,
);
---

<BaseLayout
  locale={locale}
  routeKey="versions"
  title={`${t('versions.title')} — VibeGrab`}
  description={t('versions.desc')}
  softwareVersion={payload.latest?.version}
>
  <PageHero
    eyebrow={t('versions.eyebrow')}
    title={t('versions.title')}
    description={t('versions.desc')}
    icon="history"
  >
    <div style="margin-top: var(--space-5)">
      <DataStatus payload={payload} locale={locale} />
    </div>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <p class="callout callout--info" style="margin-bottom: var(--space-6)">
        <Icon name="info" size={18} />
        <span>{t('versions.orderNote')}</span>
      </p>

      {
        stable.length > 0 ? (
          <>
            <div class="release-grid">
              {stable.map((release) => (
                <ReleaseTile release={release} locale={locale} totalDownloads={totalDownloads} />
              ))}
            </div>
            {totalDownloads > 0 && (
              <p class="release-grid__total">
                <Icon name="download" size={15} />
                {t('versions.tile.total', { count: totalDownloads })}
                <span class="tiny muted"> · {t('versions.tile.totalNote')}</span>
              </p>
            )}
          </>
        ) : hasReleases ? null : (
          <div class="pending-card">
            <Icon name="info" size={18} />
            <div>
              <p>
                <strong>{t('versions.empty')}</strong>
              </p>
              <p class="tiny" style="margin-top: var(--space-1)">{t('download.noRelease.desc')}</p>
            </div>
          </div>
        )
      }

      {
        prereleases.length > 0 && (
          <details class="release-details" style="margin-top: var(--space-8)">
            <summary>
              {t('versions.prereleases.show')} ({prereleases.length})
            </summary>
            <p class="small muted" style="margin: var(--space-4) 0">
              {t('versions.prereleases.note')}
            </p>
            <div class="release-grid">
              {prereleases.map((release) => (
                <ReleaseTile release={release} locale={locale} totalDownloads={totalDownloads} />
              ))}
            </div>
          </details>
        )
      }

      {
        withoutApk.length > 0 && (
          <div style="margin-top: var(--space-8)">
            <h2 class="section-head" style="margin-bottom: var(--space-5); font-size: var(--text-2xl)">
              {t('versions.noApk')}
            </h2>
            <div class="release-grid">
              {withoutApk.map((release) => (
                <ReleaseTile release={release} locale={locale} totalDownloads={totalDownloads} />
              ))}
            </div>
          </div>
        )
      }

      <div class="btn-row" style="margin-top: var(--space-8); justify-content:center">
        <a class="btn btn--primary btn--lg" href={path('download', locale)}>
          <Icon name="download" size={20} />
          {t('download.button')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /**
   * Abre el diálogo de detalles de una versión.
   *
   * Si el navegador no soporta `<dialog>` o no hay JavaScript, el enlace
   * lleva a la ficha permanente de la versión: nunca se queda sin salida.
   */
  function initReleaseDialogs() {
    document.querySelectorAll<HTMLAnchorElement>('[data-dialog-open]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const dialog = document.getElementById(link.dataset.dialogOpen ?? '') as
          | HTMLDialogElement
          | null;
        if (!dialog || typeof dialog.showModal !== 'function') return;
        event.preventDefault();
        dialog.showModal();
      });
    });

    // Un clic fuera del contenido cierra el diálogo.
    document.querySelectorAll<HTMLDialogElement>('.release-dialog').forEach((dialog) => {
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  }

  initReleaseDialogs();
</script>
