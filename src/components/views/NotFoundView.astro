---
/**
 * Página de error 404.
 *
 * Admite un texto propio para los casos en que el motivo está claro (por
 * ejemplo, una versión que se ha retirado de las publicaciones).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { path, type Locale } from '@/config/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
  /** Título alternativo. Por defecto, el genérico. */
  title?: string;
  /** Descripción alternativa. Por defecto, la genérica. */
  description?: string;
  /** Enlace principal alternativo. */
  primaryHref?: string;
  primaryLabel?: string;
}

const { locale, title, description, primaryHref, primaryLabel } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  routeKey="home"
  title={`404 — VibeGrab`}
  description={description ?? t('notfound.desc')}
  noindex
>
  <section class="container">
    <div class="error-page">
      <p class="error-page__code">404</p>
      <h1>{title ?? t('notfound.title')}</h1>
      <p class="lede" style="text-align:center">{description ?? t('notfound.desc')}</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary btn--lg" href={primaryHref ?? path('home', locale)}>
          {primaryLabel ?? t('notfound.home')}
        </a>
        <a class="btn btn--secondary btn--lg" href={path('versions', locale)}>
          {t('nav.versions')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
