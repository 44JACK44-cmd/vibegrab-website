---
/**
 * Página de inicio.
 *
 * Composición: portada con el producto y la versión estable real, métricas
 * verificables, escaparate de funciones con diagramas, recorrido de uso,
 * demostración de las pantallas reales de la app, novedades publicadas,
 * seguridad y uso responsable, comunidad y preguntas frecuentes.
 *
 * Todos los datos provienen de la API pública de GitHub Releases o del
 * contenido verificado en `src/content/*`.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import DeviceMockup from '@/components/DeviceMockup.astro';
import FeatureShowcase from '@/components/FeatureShowcase.astro';
import StatStrip from '@/components/StatStrip.astro';
import AppTour from '@/components/AppTour.astro';
import ScreenshotGallery from '@/components/ScreenshotGallery.astro';
import Community from '@/components/Community.astro';
import ReleaseNotes from '@/components/ReleaseNotes.astro';
import Steps from '@/components/Steps.astro';
import FaqList from '@/components/FaqList.astro';
import ReleaseWarning from '@/components/ReleaseWarning.astro';
import { features, spotlightFeatures } from '@/content/features';
import { howItWorks, provenanceNote } from '@/content/install';
import { securityPoints, limitations } from '@/content/security';
import { faq } from '@/content/faq';
import { heroScreenshot } from '@/config/screenshots';
import { pickImportant, withoutImportant } from '@/lib/notes';
import { formatBytes, formatDate } from '@/lib/format';
import { collectStats } from '@/lib/stats';
import { path, type Locale } from '@/config/routes';
import { siteConfig } from '@/config/site';
import type { ReleasesPayload } from '@/lib/releases';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
  payload: ReleasesPayload;
}

const { locale, payload } = Astro.props;
const t = useTranslations(locale);

const latest = payload.latest;
const stats = collectStats(payload);
const important = latest ? pickImportant(latest.notes) : null;
const latestNotes = latest ? withoutImportant(latest.notes) : [];
const faqPreview = faq.slice(0, 6);

const description = t('home.hero.desc');
const sizeLabel = latest?.apk ? formatBytes(latest.apk.sizeBytes, locale) : null;
const downloadHref = latest?.apk
  ? `/api/download?tag=${encodeURIComponent(latest.tag)}&lang=${locale}`
  : path('download', locale);
---

<BaseLayout
  locale={locale}
  routeKey="home"
  title={`VibeGrab — ${t('home.hero.tagline')}`}
  description={description}
  softwareVersion={latest?.version}
>
  <!-- ------------------------------------------------------------ Portada -->
  <section class="hero">
    <div class="grid-backdrop" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        {
          latest && (
            <span class="badge badge--brand">
              <span class="badge__dot" />
              {locale === 'es' ? 'Versión' : 'Version'} v{latest.version}
              {sizeLabel ? ` · ${sizeLabel}` : ''}
            </span>
          )
        }

        <div class="hero__title">
          <h1>VibeGrab</h1>
          <p class="hero__tagline">{t('home.hero.tagline')}</p>
        </div>

        <p class="hero__desc">{description}</p>

        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href={downloadHref}>
            <Icon name="download" size={20} />
            {t('home.hero.cta.download')}
          </a>
          <a class="btn btn--secondary btn--lg" href="#como-funciona">
            {t('home.hero.cta.how')}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>

        <div class="hero__meta">
          <span class="hero__meta-item">
            <Icon name="smartphone" size={16} />
            {t('home.hero.meta.android')}
          </span>
          <span class="hero__meta-item">
            <Icon name="shield" size={16} />
            {t('home.hero.meta.free')}
          </span>
          {
            sizeLabel && (
              <span class="hero__meta-item">
                <Icon name="package" size={16} />
                {sizeLabel}
              </span>
            )
          }
        </div>

        {
          latest?.publishedAt && (
            <p class="hero__stamp">
              <Icon name="calendar" size={15} />
              <span>
                {t('home.hero.published', { date: formatDate(latest.publishedAt, locale) })}
              </span>
              <a href={path('versions', locale)} class="hero__stamp-link">
                {t('home.hero.publishedLink')}
                <Icon name="arrow-right" size={14} />
              </a>
            </p>
          )
        }
      </div>

      <DeviceMockup locale={locale} release={latest} screenshot={heroScreenshot} />
    </div>
  </section>

  <!-- --------------------------------------------------------- Métricas -->
  <section class="section section--tight">
    <div class="container">
      <StatStrip stats={stats} locale={locale} />
    </div>
  </section>

  <!-- ------------------------------------------------------ Características -->
  <section class="section" id="caracteristicas">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t('home.features.eyebrow')}</p>
        <h2>{t('home.features.title')}</h2>
        <p class="lede">{t('home.features.desc')}</p>
      </div>

      <FeatureShowcase features={spotlightFeatures} locale={locale} />

      <div class="showcase__more">
        <p class="showcase__more-count">
          {t('home.features.count', { count: features.length })}
        </p>
        <a class="btn btn--secondary" href={path('features', locale)}>
          {t('home.features.all')}
          <Icon name="arrow-right" size={17} />
        </a>
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------------- Cómo funciona -->
  <section class="section section--soft" id="como-funciona">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t('home.how.eyebrow')}</p>
        <h2>{t('home.how.title')}</h2>
        <p class="lede">{t('home.how.desc')}</p>
      </div>

      <Steps steps={howItWorks} locale={locale} />

      <div class="provenance">
        <div class="provenance__head">
          <span class="card__icon" aria-hidden="true">
            <Icon name="shield" size={20} />
          </span>
          <div>
            <h3 class="provenance__title">{provenanceNote.title[locale]}</h3>
            <p class="provenance__text">{provenanceNote.text[locale]}</p>
          </div>
        </div>
        <p class="callout callout--warning">
          <Icon name="info" size={18} />
          <span>{provenanceNote.warning[locale]}</span>
        </p>
      </div>

      <div style="margin-top: var(--space-6)">
        <a class="link-arrow" href={path('help', locale)}>
          {t('home.install.cta')}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------ La aplicación -->
  <section class="section" id="demo">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t('home.demo.eyebrow')}</p>
        <h2>{t('home.demo.title')}</h2>
        <p class="lede">{t('home.demo.desc')}</p>
      </div>

      <AppTour locale={locale} />

      <div class="demo__gallery">
        <ScreenshotGallery locale={locale} />
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ Novedades -->
  {
    latest && (
      <section class="section section--soft" id="novedades">
        <div class="container">
          <div class="download-panel">
            <div class="stack">
              <div class="section-head" style="margin-bottom:0">
                <p class="eyebrow">{t('home.whatsnew.eyebrow')}</p>
                <h2>{t('home.whatsnew.title')}</h2>
                <p class="lede">
                  {locale === 'es' ? 'Versión' : 'Version'} <strong>v{latest.version}</strong>
                  {latest.build !== null ? ` (build ${latest.build})` : ''} ·{' '}
                  <time datetime={latest.publishedAt}>
                    {formatDate(latest.publishedAt, locale)}
                  </time>
                </p>
              </div>

              <div class="btn-row">
                <a
                  class="btn btn--primary"
                  href={latest.apk ? `/api/download?tag=${encodeURIComponent(latest.tag)}&lang=${locale}` : path('download', locale)}
                >
                  <Icon name="download" size={18} />
                  {latest.apk ? t('download.button.size', { size: formatBytes(latest.apk.sizeBytes, locale) }) : t('download.button')}
                </a>
                <a class="btn btn--secondary" href={path('versions', locale)}>
                  <Icon name="history" size={16} />
                  {t('download.otherVersions')}
                </a>
              </div>

              <p class="tiny muted">
                {t('home.whatsnew.sourceNote')}
              </p>
            </div>

            <div class="card">
              {important && <ReleaseWarning section={important} locale={locale} />}
              {
                latestNotes.length > 0 ? (
                  <ReleaseNotes
                    sections={latestNotes}
                    locale={locale}
                    raw={latest.notesSource === 'release-notes'}
                    headingLevel="h3"
                  />
                ) : (
                  <p class="small muted">{t('versions.noNotes')}</p>
                )
              }
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ------------------------------------------------- Seguridad y uso responsable -->
  <section class="section" id="seguridad">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t('home.security.eyebrow')}</p>
        <h2>{t('home.security.title')}</h2>
        <p class="lede">{t('home.security.desc')}</p>
      </div>

      <div class="grid grid--2">
        {
          securityPoints.map((point) => (
            <article class="card">
              <span class="card__icon" aria-hidden="true">
                <Icon name={point.icon} size={20} />
              </span>
              <h3 class="card__title">{point.title[locale]}</h3>
              <p class="card__text">{point.text[locale]}</p>
              {point.link && (
                <div class="card__foot">
                  <a class="link-arrow" href={path(point.link.key, locale)}>
                    {point.link.label[locale]}
                    <Icon name="arrow-right" size={16} />
                  </a>
                </div>
              )}
            </article>
          ))
        }
      </div>

      <div class="limitations">
        <p class="limitations__title">
          <Icon name="info" size={16} />
          {t('home.security.limitations')}
        </p>
        <ul class="notes__list">
          {
            limitations.map((item) => (
              <li class="notes__item">{item[locale]}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ Comunidad -->
  <Community locale={locale} />

  <!-- ------------------------------------------------------------------ CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <div class="cta-band__glow" aria-hidden="true"></div>
        <div class="stack stack--lg" style="align-items:center">
          <div class="stack" style="align-items:center">
            <h2>{t('home.cta.title')}</h2>
            <p class="lede" style="text-align:center">{t('home.cta.desc')}</p>
          </div>
          <div class="btn-row" style="justify-content:center">
            <a class="btn btn--primary btn--lg" href={downloadHref}>
              <Icon name="download" size={20} />
              {t('home.hero.cta.download')}
            </a>
            <a class="btn btn--secondary btn--lg" href={path('features', locale)}>
              {t('nav.features')}
            </a>
          </div>
          <p class="tiny muted">
            {siteConfig.android.minVersionLabel[locale]}+
            {sizeLabel ? ` · ${sizeLabel}` : ''} · {t('home.hero.meta.free')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------------ FAQ -->
  <section class="section section--soft" id="preguntas">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        <p class="eyebrow">{t('home.faq.eyebrow')}</p>
        <h2>{t('home.faq.title')}</h2>
      </div>

      <FaqList items={faqPreview} locale={locale} openFirst />

      <div style="margin-top: var(--space-6); text-align:center">
        <a class="link-arrow" href={path('help', locale)}>
          {t('home.faq.cta')}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
