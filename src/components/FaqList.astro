---
/**
 * Lista de preguntas frecuentes en acordeón nativo (`details`/`summary`),
 * accesible por teclado y sin JavaScript.
 */
import Icon from '@/components/Icon.astro';
import type { FaqItem } from '@/content/faq';
import { path, type Locale } from '@/config/routes';

interface Props {
  items: FaqItem[];
  locale: Locale;
  /** Abre la primera pregunta por defecto. */
  openFirst?: boolean;
}

const { items, locale, openFirst = false } = Astro.props;
---

<div class="faq">
  {
    items.map((item, index) => (
      <details class="faq__item" open={openFirst && index === 0}>
        <summary class="faq__question">
          <span>{item.question[locale]}</span>
          <Icon name="chevron-down" size={18} />
        </summary>
        <div class="faq__answer">
          {item.answer.map((paragraph) => (
            <p>{paragraph[locale]}</p>
          ))}
          {item.link && (
            <p>
              <a class="link-arrow" href={path(item.link.key, locale)}>
                {item.link.label[locale]}
                <Icon name="arrow-right" size={16} />
              </a>
            </p>
          )}
        </div>
      </details>
    ))
  }
</div>
