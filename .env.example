# VibeGrab - sitio web oficial
# =====================================================================
# Copia este archivo a `.env` para desarrollo local:
#   copy .env.example .env
#
# En Vercel estas variables se configuran en
# Project -> Settings -> Environment Variables (ver DEPLOY.md).
#
# IMPORTANTE: solo las variables con prefijo PUBLIC_ llegan al navegador.
# NUNCA pongas un token en una variable PUBLIC_.
# =====================================================================

# --- Sitio ---------------------------------------------------------------
# URL canónica (con https y sin barra final). Se usa para canonical, Open
# Graph, robots.txt y los sitemaps.
#
# Déjala VACÍA mientras no tengas un dominio propio: en Vercel se usa
# automáticamente el dominio de producción del proyecto
# (`VERCEL_PROJECT_PRODUCTION_URL`, que Vercel inyecta sola) y, en local sin
# nada configurado, el respaldo comprobado del proyecto.
# Rellénala SOLO cuando hayas registrado un dominio propio, y nunca con un
# dominio que no sea tuyo.
SITE_URL=

# --- GitHub Releases -----------------------------------------------------
# Repositorio del que se leen las publicaciones (versiones y APK).
GITHUB_REPO=44JACK44-cmd/vibeGrab

# Token de solo lectura para subir el límite de la API de GitHub de
# 60 a 5.000 peticiones/hora. Es OPCIONAL: sin él la web funciona igual,
# gracias a la caché y al respaldo estático.
# Créalo en: GitHub -> Settings -> Developer settings -> Tokens (classic),
# con el permiso mínimo `public_repo` (o ninguno, para repos públicos).
# NUNCA lo marques como PUBLIC_: solo se lee en el servidor.
#
# IMPORTANTE: el canal de opiniones de la comunidad escribe en el repositorio
# de la web (crea issues). Para que ese canal funcione, el token necesita
# permiso de escritura (`public_repo`). Sin él, el formulario no se muestra.
GITHUB_TOKEN=

# Minutos que se reutiliza la respuesta de GitHub antes de volver a consultar.
RELEASES_CACHE_MINUTES=10

# Minutos que se reutiliza la lista de opiniones de la comunidad antes de
# volver a consultar los issues del repositorio.
REVIEWS_CACHE_MINUTES=10

# Si vale 1, las opiniones se guardan cerradas y hay que abrirlas para que
# aparezcan en la web (moderación previa). Con 0 se publican al instante.
REVIEWS_REQUIRE_MODERATION=0

# Máximo de opiniones que puede enviar la misma IP en una hora.
REVIEWS_MAX_PER_HOUR=5

# Segundos de espera antes de reintentar cuando GitHub falla (evita insistir
# en cada visita mientras hay un error o un límite de peticiones).
RELEASES_RETRY_SECONDS=60

# --- Contacto y soporte --------------------------------------------------
# Deja vacío hasta tener un canal real. La web NO inventa direcciones:
# si están vacías, la página de contacto lo indica de forma explícita.
CONTACT_EMAIL=

# Canal de soporte (foro, formulario, issue tracker...). Opcional.
SUPPORT_URL=

# --- Datos de contacto publicados ----------------------------------------
# Los que publica el responsable del proyecto. Si se dejan vacíos, se usan los
# valores que ya están en el código (src/config/site.ts).
#
# Teléfono tal como se muestra. CONTACT_PHONE_E164 es el formato internacional
# para que el enlace «tel:» funcione (por ejemplo +34600000000). Sin él, el
# número se muestra pero no se puede marcar con un clic.
CONTACT_PHONE=944834202
CONTACT_PHONE_E164=

# Perfiles sociales oficiales.
CONTACT_FACEBOOK=https://www.facebook.com/amilcar.aymaraenciso.1
CONTACT_TIKTOK=https://www.tiktok.com/@4_jck_6

# Canal de soporte (foro, formulario, issue tracker...). Opcional.
SUPPORT_URL=

# --- Analítica (opcional, desactivada por defecto) -----------------------
# Analítica sin cookies, respetuosa con la privacidad. Si se deja vacío no
# se carga NINGÚN script de analítica ni de terceros.
# Ejemplo con Plausible: PUBLIC_ANALYTICS_DOMAIN=midominio.com
PUBLIC_ANALYTICS_DOMAIN=
# Dominio del script, por si usas una instancia propia.
PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
