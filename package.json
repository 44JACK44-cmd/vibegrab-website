{
  "name": "vibegrab-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio web oficial de VibeGrab: presentación, descargas y novedades de la app.",
  "scripts": {
    "dev": "astro dev",
    "start": "node ./scripts/start.mjs",
    "build": "astro check && astro build",
    "build:fast": "astro build",
    "build:cf": "node scripts/build-target.mjs cloudflare",
    "build:render": "node scripts/build-target.mjs render",
    "deploy:cf": "node scripts/build-target.mjs cloudflare --deploy",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "node scripts/check-links.mjs",
    "snapshot": "node scripts/snapshot-releases.mjs",
    "assets": "node scripts/generate-og.mjs",
    "assets:logo": "node scripts/optimize-logo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.4.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "workerd@1.20261023.1": true
  }
}
