# Cabeceras para los ASSETS ESTÁTICOS de Cloudflare.
#
# Las respuestas generadas por el Worker (SSR y API) reciben estas cabeceras
# desde el middleware (`src/middleware.ts`); este fichero cubre el resto:
# HTML prerenderizado, CSS/JS con hash, imágenes y favicons.
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Los ficheros de _astro llevan hash en el nombre: caché de un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# La marca y las imágenes sociales cambian poco.
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og-image.png
  Cache-Control: public, max-age=604800

/og-image-en.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
